      <script type="text/javascript" charset="utf-8">
        $(document).ready(function() {
            const myForm = document.getElementById("form-login");
            const validatorForm = checkForm(myForm);
        
            $(".btn-login").on("click", function(e) {
            	e.preventDefault();
            
            	var obj = {};
            	$(".form-attr").each(function(index, select) {
            		var current = $(select);
            		if (current.attr("name") == "rememberme") {
            			if (current.is(":checked")) {
            				obj[current.attr("name")] = true;
            			} else {
            				obj[current.attr("name")] = false;
            			}
            		} else {
            			obj[current.attr("name")] = current.val();
            		}
            	});
            
            	if (validatorForm) {
            		validatorForm.validate().then(function(status) {
            			if (status == "Valid") {
            				$.ajax({
        						url: "/includes/ajax.php?c=login",
        						type: "POST",
        						cache: false,
        						data: obj,
        						beforeSend: function() {
									$("#loading").addClass("loader");
									
        							$("#form-login").css("opacity", ".5");
        							$(".btn-login").attr("disabled", "disabled");
        						},
        						success: function(data) {
									$("#loading").removeClass("loader");
									
        							if (data.statusCode == true && data.responseCode == 200) {
        								Swal.fire({
        									title: "Informasi",
        									text: data.message,
        									icon: "success",
        									showClass: {
        										popup: "animate__animated animate__tada"
        									},
        									customClass: {
        										confirmButton: "btn btn-primary"
        									},
        									buttonsStyling: !1
        								}).then(function(e) {
        									window.location = "/?p=home";
        								});
        							} else {
        							    if (data.responseCode === 520) {
                                            Swal.fire({
                                                title: "Informasi", 
                                                text: data.message, 
                                                icon: "warning", 
                                                showClass: {
                                                    popup: "animate__animated animate__tada"
                                                }, 
                                                customClass: { 
                                                    confirmButton: "btn btn-primary"
                                                }, 
                                                buttonsStyling:!1
                                            }).then(function (e) {
                                                window.location.href = "'.SITE_URL.'?p=logout";
                                            });
                                        } else if (data.responseCode === 401) {
                                            Swal.fire({
                                                title: "Informasi", 
                                                text: data.message, 
                                                icon: "warning", 
                                                showClass: {
                                                    popup: "animate__animated animate__tada"
                                                }, 
                                                customClass: { 
                                                    confirmButton: "btn btn-primary"
                                                }, 
                                                buttonsStyling:!1
                                            }).then(function (e) {
                                                window.location.href = "'.SITE_URL.'?p=logout";
                                            });
                                        } else if (data.responseCode === 302) {
                                            Swal.fire({
                                                title: "Informasi", 
                                                text: data.message, 
                                                icon: "warning", 
                                                showClass: {
                                                    popup: "animate__animated animate__tada"
                                                }, 
                                                customClass: { 
                                                    confirmButton: "btn btn-primary"
                                                }, 
                                                buttonsStyling:!1
                                            }).then(function (e) { 
                                                window.location.href = "'.SITE_URL.'?p=home";
                                            });
                                        } else {
                                            Swal.fire({
                                                title: "Informasi", 
                                                text: data.message, 
                                                icon: "warning", 
                                                showClass: {
                                                    popup: "animate__animated animate__tada"
                                                }, 
                                                customClass: { 
                                                    confirmButton: "btn btn-primary"
                                                }, 
                                                buttonsStyling:!1
                                            }).then(function (e) {
                                                $("#form-login").css("opacity", "");
            									$(".btn-login").removeAttr("disabled");
                                            });
                                        }
                                    }
        						},
        						error: function(jqXHR, exception) {
									$("#loading").removeClass("loader");
									
        							var error_msg = "";
        							if (jqXHR.status === 0) {
        								error_msg = "Not connect.\n Verify Network.";
        							} else if (jqXHR.status == 404) {
        								// 404 page error
        								error_msg = "Requested page not found. [404]";
        							} else if (jqXHR.status == 500) {
        								// 500 Internal Server error
        								error_msg = "Internal Server Error [500].";
        							} else if (exception === "parsererror") {
        								// Requested JSON parse
        								error_msg = "Requested JSON parse failed.";
        							} else if (exception === "timeout") {
        								// Time out error
        								error_msg = "Time out error.";
        							} else if (exception === "abort") {
        								// request aborte
        								error_msg = "Ajax request aborted.";
        							} else {
        								error_msg = "Uncaught Error.\n" + jqXHR.responseText;
        							}
        
        							Swal.fire({
        								title: "Informasi",
        								text: error_msg,
        								icon: "error",
        								showClass: {
        									popup: "animate__animated animate__tada"
        								},
        								customClass: {
        									confirmButton: "btn btn-primary"
        								},
        								buttonsStyling: !1
        							}).then(function(e) {
        								$("#form-login").css("opacity", "");
        								$(".btn-login").removeAttr("disabled");
        							});
        						}
        					});
            			}
            		});
            	} else {
            		Swal.fire({
            			title: "Informasi",
            			text: "Gagal melakukan login akun, dikarenakan sistem yang bermasalah. Silakan hubungi pihak admin terkait pesan error sebagai berikut!",
            			icon: "warning",
            			showClass: {
            				popup: "animate__animated animate__tada"
            			},
            			customClass: {
            				confirmButton: "btn btn-primary"
            			},
            			buttonsStyling: !1
            		}).then(function(e) {
            			$("#form-login").css("opacity", "");
            			$(".btn-login").removeAttr("disabled");
            		});
            	}
            });
        });
        
        function checkForm(form) {
        	const validator = new FormValidation.formValidation(form, {
        		fields: {
        			'username': {
                        validators: {
                            notEmpty: {
                                message: "Silakan masukkan nama pengguna Anda"
                            },
                            stringLength: {
                                min: 6,
                                message: "Nama pengguna harus lebih dari 6 karakter"
                            },
                            regexp: {
                                regexp: /^[a-zA-Z0-9 ]+$/,
                                message: "Nama pengguna hanya boleh terdiri dari huruf, angka, dan spasi"
                            }
                        }
                    },
        			'password': {
                        validators: {
                            notEmpty: {
                                message: "Silakan masukkan kata sandi Anda"
                            },
                            stringLength: {
                                min: 6,
                                message: "Kata sandi harus lebih dari 6 karakter"
                            }
                        }
                    },
        		},
        		plugins: {
        			trigger: new FormValidation.plugins.Trigger,
                    bootstrap5: new FormValidation.plugins.Bootstrap5({
        				eleValidClass: "",
        				rowSelector: function(e, a) {
        				    switch(e) {
        				        case "username":
        					        return ".mb-3"
        				        case "password":
        					        return ".mb-3"
        				        default:
                                    return ".row"
        				    }
        				}
        			}),
                    autoFocus: new FormValidation.plugins.AutoFocus
        		},
        		init: e => {
                    e.on("plugins.message.placed", function(e) {
                        e.element.parentElement.classList.contains("input-group") && e.element.parentElement.insertAdjacentElement("afterend", e.messageElement)
                    })
                }
        	});
    	    return validator;
        }
      </script>
      <!-- / JavaScript -->
   </body>
</html>

